# Generate: openssl rand -base64 32
AUTH_SECRET=

# Neon Postgres — https://neon.tech or Vercel Storage
DATABASE_URL=

# Optional: movie & series auto-fill (TMDB v3 API key or v4 read access token)
TMDB_API_KEY=

# Optional: game auto-fill (RAWG) — Wikipedia fallback works without it
RAWG_API_KEY=

# Optional: companion-app integration (hospital companion). Generate: openssl rand -hex 32
# INTEGRATION_USERNAME is the Fun Mun username whose list the companion reads and updates.
INTEGRATION_TOKEN=
INTEGRATION_USERNAME=

# Set to your production URL on Vercel (e.g. https://fun-mun.vercel.app)
AUTH_URL=http://localhost:3000
